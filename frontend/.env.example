# ==============================================================================
# MedCore HMS Frontend - Environment Configuration Template
# ==============================================================================
# In Vite, all environment variables exposed to client code MUST start with VITE_
# Access them in React via: import.meta.env.VITE_VARIABLE_NAME
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Details
# ------------------------------------------------------------------------------
VITE_APP_NAME="MedCore HMS"
VITE_APP_DESCRIPTION="Enterprise Hospital Management System"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# ------------------------------------------------------------------------------
# 2. Backend API & WebSockets (for when your backend is running)
# ------------------------------------------------------------------------------
# Base REST API URL (e.g., Express, FastAPI, Django, Spring Boot, or ASP.NET)
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# WebSocket server URL for real-time patient queues, vitals, and emergency alerts
VITE_WS_URL="ws://localhost:5000/ws"

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000

# ------------------------------------------------------------------------------
# 3. Feature Flags & Mock Simulation
# ------------------------------------------------------------------------------
# Set to 'true' to use local interactive simulated data for doctor queues, vitals, and census
# Set to 'false' to connect directly to live backend endpoints
VITE_USE_MOCK_DATA=true

# Enable / Disable debug logs in browser console
VITE_ENABLE_DEBUG_LOGS=true

# ------------------------------------------------------------------------------
# 4. Third-Party Integrations & Notifications (Optional)
# ------------------------------------------------------------------------------
# Webhook URL for forwarding "Book a Demo" or "Talk to the team" submissions
# e.g., Slack Webhook, Zapier, Make, or Email Service API
VITE_DEMO_LEADS_WEBHOOK=""

# Support & Contact Email shown in inquiries
VITE_CONTACT_EMAIL="enterprise@medcorehms.com"
VITE_SUPPORT_PHONE="+1 (800) 555-CORE"

# ------------------------------------------------------------------------------
# 5. Security & Compliance Settings
# ------------------------------------------------------------------------------
# HIPAA / GDPR strict compliance mode flag
VITE_HIPAA_COMPLIANCE_MODE=true

# Session timeout for inactive clinical workstations (in minutes)
VITE_INACTIVITY_TIMEOUT_MINUTES=15
