datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Role & User Core ──────────────────────────────────────────
enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  ACCOUNTANT
  PATIENT
}

model Hospital {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String?
  country     String?  @default("India")
  phone       String?
  email       String?
  logoUrl     String?  @map("logo_url")
  taxNumber   String?  @map("tax_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  patients    Patient[]

  @@map("hospitals")
}

model User {
  id            String    @id @default(uuid())
  hospitalId    String?   @map("hospital_id")
  hospital      Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  role          UserRole  @default(DOCTOR)
  fullName      String    @map("full_name")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  employeeId    String?   @map("employee_id")
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  doctorProfile          DoctorProfile?
  nurseProfile           NurseProfile?
  receptionistProfile    ReceptionistProfile?
  pharmacistProfile      PharmacistProfile?
  labTechnicianProfile   LabTechnicianProfile?
  accountantProfile      AccountantProfile?
  notifications          Notification[]
  auditLogs              AuditLog[]
  receivedPayments       Payment[]               @relation("PaymentReceiver")
  createdInvoices        Invoice[]               @relation("InvoiceCreator")
  cancelledInvoices      Invoice[]               @relation("InvoiceCanceller")
  voidedPayments         Payment[]               @relation("PaymentVoider")
  createdAdjustments     InvoiceAdjustment[]     @relation("AdjustmentCreator")
  requestedRefunds       Refund[]                @relation("RefundRequester")
  approvedRefunds        Refund[]                @relation("RefundApprover")
  processedRefunds       Refund[]                @relation("RefundProcessor")
  createdExpenses        Expense[]               @relation("ExpenseCreator")
  cancelledExpenses      Expense[]               @relation("ExpenseCanceller")
  bookedAppointments     Appointment[]           @relation("AppointmentBooker")
  cancelledAppointments  Appointment[]           @relation("AppointmentCanceller")
  emergencyRegistrations EmergencyRegistration[] @relation("EmergencyRegistrar")
  stockTransactions      StockTransaction[]      @relation("StockTransactionPerformer")
  stockReceipts          StockReceipt[]          @relation("StockReceiptReceiver")
  dispensings            Dispensing[]            @relation("DispensingPharmacist")
  heldPrescriptions      Prescription[]          @relation("PrescriptionHolder")
  collectedSamples       LabSample[]             @relation("SampleCollector")
  receivedSamples        LabSample[]             @relation("SampleReceiver")
  processingStartedSamples LabSample[]           @relation("SampleProcessor")
  processingCompletedSamples LabSample[]         @relation("SampleCompleter")
  rejectedSamples        LabSample[]             @relation("SampleRejector")
  enteredResults         LabResult[]             @relation("ResultEnterer")
  verifiedResults        LabResult[]             @relation("ResultVerifier")
  correctedResults       LabResultCorrection[]   @relation("ResultCorrector")
  createdReports         LabReport[]             @relation("ReportCreator")
  verifiedReports        LabReport[]             @relation("ReportVerifier")
  releasedReports        LabReport[]             @relation("ReportReleaser")
  patient                Patient?                @relation("PatientUser")
  portalInvitesCreated   PortalInvite[]          @relation("InviteCreator")

  @@index([email])
  @@index([hospitalId])
  @@map("users")
}

// ── Doctor Profile & Availability ─────────────────────────────
model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      String
  specialization  String
  licenseNumber   String   @map("license_number")
  consultationFee Decimal  @default(500.00) @map("consultation_fee") @db.Decimal(10, 2)
  experienceYears Int      @default(5) @map("experience_years")
  qualifications  String[] @default([])
  bio             String?
  roomNumber      String?  @map("room_number")
  status          String   @default("Available") // Available, In Consultation, On Leave
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  availabilities  DoctorAvailability[]
  appointments    Appointment[]
  consultations   Consultation[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labTestOrders   LabTestOrder[]
  followUps       FollowUp[]

  @@map("doctor_profiles")
}

model DoctorAvailability {
  id                   String        @id @default(uuid())
  doctorId             String        @map("doctor_id")
  doctor               DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek            Int           @map("day_of_week") // 0=Sun, 1=Mon, ..., 6=Sat
  startTime            String        @map("start_time")  // "09:00"
  endTime              String        @map("end_time")    // "17:00"
  breakStartTime       String?       @map("break_start_time") // "13:00"
  breakEndTime         String?       @map("break_end_time")   // "14:00"
  consultationDuration Int           @default(15) @map("consultation_duration") // in minutes
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([doctorId, dayOfWeek])
  @@map("doctor_availabilities")
}

// ── Nurse Profile & Assignments ───────────────────────────────
model NurseProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     String   @default("Inpatient Wards & Triage")
  ward           String   @default("Ward 3B - General Medical")
  shift          String   @default("Day (08:00 - 16:00)") // Day, Evening, Night, Rotating
  status         String   @default("On Duty") // On Duty, Off Duty, On Break
  licenseNumber  String   @map("license_number")
  qualifications String[] @default([])
  bio            String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assignments               NurseAssignment[]
  vitalSigns                VitalSign[]
  nursingNotes              NursingNote[]
  medicationAdministrations MedicationAdministration[]

  @@map("nurse_profiles")
}

model NurseAssignment {
  id           String       @id @default(uuid())
  nurseId      String       @map("nurse_id")
  nurse        NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  patientId    String       @map("patient_id")
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ward         String?
  assignedDate DateTime     @default(now()) @map("assigned_date")
  shift        String?
  isActive     Boolean      @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([nurseId, isActive])
  @@index([patientId, isActive])
  @@map("nurse_assignments")
}

// ── Receptionist Profile ──────────────────────────────────────
model ReceptionistProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String   @default("Front Desk & OPD Registration")
  shift       String   @default("Morning (08:00 - 16:00)") // Morning, Evening, Night
  status      String   @default("On Duty") // On Duty, Off Duty, On Break
  employeeId  String?  @map("employee_id")
  phone       String?
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("receptionist_profiles")
}

// ── Pharmacist Profile ────────────────────────────────────────
model PharmacistProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    String   @default("Central Pharmacy & Dispensary")
  licenseNumber String   @map("license_number")
  shift         String   @default("Day (08:00 - 16:00)") // Day, Evening, Night, Rotating
  status        String   @default("On Duty") // On Duty, Off Duty, On Break
  employeeId    String?  @map("employee_id")
  phone         String?
  bio           String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("pharmacist_profiles")
}

// ── Accountant Profile ─────────────────────────────────────────
model AccountantProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String   @unique @map("employee_id")
  department       String   @default("Finance & Revenue Cycle Management")
  status           String   @default("On Duty") // On Duty, Off Duty, On Leave
  isSeniorApprover Boolean  @default(false) @map("is_senior_approver") // Placeholder permission flag
  phone            String?
  bio              String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("accountant_profiles")
}

// ── Patient Model ─────────────────────────────────────────────
model Patient {
  id                String    @id @default(uuid())
  hospitalId        String?   @map("hospital_id")
  hospital          Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  userId            String?   @unique @map("user_id")
  user              User?     @relation("PatientUser", fields: [userId], references: [id], onDelete: SetNull)
  patientIdNumber   String    @unique @map("patient_id_number") // e.g. "MED-P-1001" or "MC-2026-000123"
  fullName          String    @map("full_name")
  dateOfBirth       DateTime? @map("date_of_birth")
  age               Int?
  gender            String    // Male, Female, Other
  bloodGroup        String?   @map("blood_group") // A+, O+, etc.
  phone             String
  email             String?
  address           String?
  emergencyContact  String?   @map("emergency_contact")
  emergencyPhone    String?   @map("emergency_phone")
  allergies         String[]  @default([])
  chronicConditions String[]  @default([]) @map("chronic_conditions")
  status            String    @default("Active") // Active, Inpatient, Discharged
  registrationDate  DateTime  @default(now()) @map("registration_date")
  registrationSource String   @default("Standard") @map("registration_source") // Standard, Emergency, Referral
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  appointments              Appointment[]
  consultations             Consultation[]
  medicalRecords            MedicalRecord[]
  prescriptions             Prescription[]
  labTestOrders             LabTestOrder[]
  labSamples                LabSample[]
  documents                 Document[]
  followUps                 FollowUp[]
  nurseAssignments          NurseAssignment[]
  vitalSigns                VitalSign[]
  nursingNotes              NursingNote[]
  medicationAdministrations MedicationAdministration[]
  admissions                Admission[]
  beds                      Bed[]
  invoices                  Invoice[]
  payments                  Payment[]
  emergencyRecords          EmergencyRegistration[]
  dispensings               Dispensing[]
  portalInvites             PortalInvite[]
  paymentAttempts           PaymentAttempt[]
  insurancePolicies         InsurancePolicy[]
  insuranceClaims           InsuranceClaim[]

  @@index([patientIdNumber])
  @@index([phone])
  @@index([fullName])
  @@index([createdAt])
  @@map("patients")
}

// ── Appointments & State Machine ──────────────────────────────
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique @map("appointment_number") // e.g. "APT-2026-101"
  doctorId          String            @map("doctor_id")
  doctor            DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId         String            @map("patient_id")
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentDate   DateTime          @map("appointment_date") @db.Date
  appointmentTime   String            @map("appointment_time") // "10:30"
  type              String            @default("General") // General, Follow-up, Emergency, Routine
  status            AppointmentStatus @default(SCHEDULED)
  reason            String?
  cancelReason      String?           @map("cancel_reason")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelledById     String?           @map("cancelled_by_id")
  cancelledBy       User?             @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  bookedById        String?           @map("booked_by_id")
  bookedBy          User?             @relation("AppointmentBooker", fields: [bookedById], references: [id], onDelete: SetNull)
  isCheckedIn       Boolean           @default(false) @map("is_checked_in") // Supports "Waiting" display
  checkedInAt       DateTime?         @map("checked_in_at")
  rescheduleCount   Int               @default(0) @map("reschedule_count")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  consultation      Consultation?
  invoice           Invoice?

  @@index([doctorId, appointmentDate, status])
  @@index([patientId])
  @@index([appointmentDate, status])
  @@map("appointments")
}

// ── Consultations & Medical Records ───────────────────────────
enum ConsultationStatus {
  DRAFT
  COMPLETED
}

model Consultation {
  id             String             @id @default(uuid())
  appointmentId  String             @unique @map("appointment_id")
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId       String             @map("doctor_id")
  doctor         DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId      String             @map("patient_id")
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status         ConsultationStatus @default(DRAFT)
  chiefComplaint String?            @map("chief_complaint")
  symptoms       String[]           @default([])
  vitals         Json?              // { bp: "120/80", heartRate: 72, temp: 98.6, spo2: 99, weight: 70, height: 175 }
  clinicalNotes  String?            @map("clinical_notes")
  diagnosis      String?
  treatmentPlan  String?            @map("treatment_plan")
  doctorNotes    String?            @map("doctor_notes")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  prescription   Prescription?
  medicalRecord  MedicalRecord?

  @@index([doctorId])
  @@index([patientId])
  @@map("consultations")
}

model MedicalRecord {
  id             String        @id @default(uuid())
  recordNumber   String        @unique @map("record_number") // "REC-2026-001"
  patientId      String        @map("patient_id")
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String        @map("doctor_id")
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultationId String?       @unique @map("consultation_id")
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  recordType     String        @default("Consultation") @map("record_type") // Consultation, Lab, Discharge, General
  title          String
  summary        String?
  diagnosis      String?
  notes          String?
  vitalsSnapshot Json?         @map("vitals_snapshot")
  portalVisible  Boolean       @default(true) @map("portal_visible")
  recordDate     DateTime      @default(now()) @map("record_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  documents      Document[]

  @@index([patientId, recordDate])
  @@index([doctorId])
  @@map("medical_records")
}

// ── Prescriptions & Items ─────────────────────────────────────
model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique @map("prescription_number") // "RX-2026-101"
  doctorId           String             @map("doctor_id")
  doctor             DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId          String             @map("patient_id")
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId     String?            @unique @map("consultation_id")
  consultation       Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  notes              String?
  status             String             @default("Active") // Active, Dispensed, Discontinued
  onHold             Boolean            @default(false) @map("on_hold")
  holdReason         String?            @map("hold_reason")
  heldById           String?            @map("held_by_id")
  heldBy             User?              @relation("PrescriptionHolder", fields: [heldById], references: [id], onDelete: SetNull)
  heldAt             DateTime?          @map("held_at")
  dispensingStatus   String             @default("PENDING") @map("dispensing_status") // PENDING, PARTIALLY_DISPENSED, DISPENSED, ON_HOLD, CANCELLED
  prescribedDate     DateTime           @default(now()) @map("prescribed_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  items              PrescriptionItem[]
  documents          Document[]
  dispensings        Dispensing[]

  @@index([doctorId])
  @@index([patientId])
  @@index([dispensingStatus])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                 String       @id @default(uuid())
  prescriptionId     String       @map("prescription_id")
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId         String?      @map("medicine_id")
  medicine           Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName       String       @map("medicine_name")
  dosage             String       // "500mg"
  frequency          String       // "1-0-1 (Twice Daily)"
  duration           String       // "5 Days"
  quantityPrescribed Int?         @map("quantity_prescribed")
  quantityDispensed  Int          @default(0) @map("quantity_dispensed")
  route              String       @default("Oral") // Oral, Topical, IV, Inhalation
  instructions       String?      // "After food with warm water"
  createdAt          DateTime     @default(now()) @map("created_at")

  medicationAdministrations MedicationAdministration[]
  dispensingItems           DispensingItem[]

  @@map("prescription_items")
}

// ── Vital Signs Monitoring (Nurse) ───────────────────────────
model VitalSign {
  id               String       @id @default(uuid())
  patientId        String       @map("patient_id")
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId          String       @map("nurse_id")
  nurse            NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  bloodPressure    String       @map("blood_pressure") // e.g. "120/80"
  systolic         Int?
  diastolic        Int?
  temperature      Float        // in Fahrenheit, e.g. 98.6
  pulse            Int          // bpm
  respiratoryRate  Int          @map("respiratory_rate") // breaths/min
  oxygenSaturation Int          @map("oxygen_saturation") // SpO2 %
  weight           Float?       // in kg
  height           Float?       // in cm
  observation      String?
  isFlagged        Boolean      @default(false) @map("is_flagged")
  flagReason       String?      @map("flag_reason")
  recordedAt       DateTime     @default(now()) @map("recorded_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([patientId, recordedAt])
  @@index([nurseId])
  @@map("vital_signs")
}

// ── Nursing Notes ────────────────────────────────────────────
model NursingNote {
  id              String       @id @default(uuid())
  patientId       String       @map("patient_id")
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId         String       @map("nurse_id")
  nurse           NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  shift           String?
  observation     String       // Clinical observation
  careProvided    String       @map("care_provided") // Interventions and nursing care given
  patientResponse String       @map("patient_response") // How patient responded
  additionalNotes String?      @map("additional_notes")
  isFlagged       Boolean      @default(false) @map("is_flagged")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([patientId, createdAt])
  @@index([nurseId])
  @@map("nursing_notes")
}

// ── Medication Administration (e-MAR) ────────────────────────
enum MedAdminStatus {
  SCHEDULED
  DUE
  ADMINISTERED
  HELD
  MISSED
  CANCELLED
}

model MedicationAdministration {
  id                 String            @id @default(uuid())
  patientId          String            @map("patient_id")
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId            String?           @map("nurse_id")
  nurse              NurseProfile?     @relation(fields: [nurseId], references: [id], onDelete: SetNull)
  prescriptionItemId String?           @map("prescription_item_id")
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  medicineName       String            @map("medicine_name")
  dosage             String            // "500mg"
  route              String            @default("Oral") // Oral, IV, IM, Inhalation, Topical
  frequency          String?           // "Twice Daily"
  scheduledAt        DateTime          @map("scheduled_at")
  administeredAt     DateTime?         @map("administered_at")
  status             MedAdminStatus    @default(SCHEDULED)
  reason             String?           // Required for HELD and MISSED
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([patientId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([nurseId])
  @@map("medication_administrations")
}

// ── Inpatient Admissions ──────────────────────────────────────
enum AdmissionStatus {
  PENDING
  ADMITTED
  TRANSFERRED
  DISCHARGED
}

model Admission {
  id                 String          @id @default(uuid())
  admissionNumber    String          @unique @map("admission_number")
  patientId          String          @map("patient_id")
  patient            Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admittedDate       DateTime        @default(now()) @map("admitted_date")
  dischargeDate      DateTime?       @map("discharge_date")
  ward               String          // e.g. "Ward 3B - General Medical"
  roomNumber         String          @map("room_number") // "Room 204"
  bedNumber          String          @map("bed_number")  // "Bed 2"
  status             AdmissionStatus @default(ADMITTED)
  attendingDoctor    String?         @map("attending_doctor") // "Dr. Sarah Chen"
  admittingDiagnosis String?         @map("admitting_diagnosis")
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([status])
  @@map("admissions")
}

// ── Beds & Wards ──────────────────────────────────────────────
enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Bed {
  id         String    @id @default(uuid())
  bedNumber  String    @map("bed_number")
  roomNumber String    @map("room_number")
  ward       String
  status     BedStatus @default(AVAILABLE)
  patientId  String?   @map("patient_id")
  patient    Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([ward, roomNumber, bedNumber])
  @@map("beds")
}

// ── Service Catalog (Shared Hospital Billing Catalog) ─────────
model ServiceCatalog {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "SRV-CONS-GEN", "SRV-CONS-SPEC"
  name        String
  category    String        // "Consultation", "Diagnostic", "Procedure", "Emergency", "Ward & Bed"
  price       Decimal       @db.Decimal(10, 2)
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]

  @@map("service_catalog")
}

// ── Invoices & Line Items (Shared Hospital Billing System) ────
enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
  CANCELLED
}

enum ExpenseStatus {
  RECORDED
  CANCELLED
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique @map("invoice_number") // e.g. "INV-2026-0001"
  patientId         String        @map("patient_id")
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId     String?       @unique @map("appointment_id")
  appointment       Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById       String?       @map("created_by_id")
  createdBy         User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  type              String        @default("General") // Consultation, Pharmacy, Diagnostic, Mixed, General
  invoiceDate       DateTime      @default(now()) @map("invoice_date") @db.Date
  issueDate         DateTime      @default(now()) @map("issue_date")
  dueDate           DateTime?     @map("due_date") @db.Date
  subtotal          Decimal       @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  adjustmentAmount  Decimal       @default(0.00) @map("adjustment_amount") @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  refundedAmount    Decimal       @default(0.00) @map("refunded_amount") @db.Decimal(12, 2)
  outstandingAmount Decimal       @map("outstanding_amount") @db.Decimal(12, 2)
  status            InvoiceStatus @default(PENDING)
  notes             String?
  idempotencyKey    String?       @unique @map("idempotency_key")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelledById     String?       @map("cancelled_by_id")
  cancelledBy       User?         @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason      String?       @map("cancel_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  items             InvoiceItem[]
  payments          Payment[]
  dispensings       Dispensing[]
  adjustments       InvoiceAdjustment[]
  refunds           Refund[]
  paymentAttempts   PaymentAttempt[]

  @@index([patientId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                 String            @id @default(uuid())
  invoiceId          String            @map("invoice_id")
  invoice            Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceCatalogId   String?           @map("service_catalog_id")
  serviceCatalog     ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  serviceName        String            @map("service_name")
  category           String            @default("General")
  source             String            @default("GENERAL") // GENERAL, CLINICAL, PHARMACY, LAB
  dispensingItemId   String?           @map("dispensing_item_id")
  labTestOrderItemId String?           @map("lab_test_order_item_id")
  labTestOrderItem   LabTestOrderItem? @relation(fields: [labTestOrderItemId], references: [id], onDelete: SetNull)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(12, 2)
  quantity           Int               @default(1)
  discount           Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate            Decimal           @default(0.00) @map("tax_rate") @db.Decimal(5, 2) // e.g. 5.00, 12.00, 18.00 %
  taxAmount          Decimal           @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalPrice         Decimal           @map("total_price") @db.Decimal(12, 2)
  createdAt          DateTime          @default(now()) @map("created_at")

  adjustments        InvoiceAdjustment[]

  @@index([invoiceId])
  @@index([source])
  @@map("invoice_items")
}

model InvoiceAdjustment {
  id            String         @id @default(uuid())
  invoiceId     String         @map("invoice_id")
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItemId String?        @map("invoice_item_id")
  invoiceItem   InvoiceItem?   @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  type          AdjustmentType @default(CREDIT)
  amount        Decimal        @db.Decimal(12, 2)
  reason        String
  createdById   String?        @map("created_by_id")
  createdBy     User?          @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_adjustments")
}

// ── Payments ──────────────────────────────────────────────────
model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique @map("payment_number") // e.g. "PAY-2026-0001"
  invoiceId       String        @map("invoice_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId       String        @map("patient_id")
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  referenceNumber String?       @map("reference_number") // Transaction ID / Reference (No raw card data)
  paymentDate     DateTime      @default(now()) @map("payment_date") @db.Date
  paidAt          DateTime      @default(now()) @map("paid_at")
  status          String        @default("COMPLETED") // COMPLETED, VOIDED
  idempotencyKey  String?       @unique @map("idempotency_key")
  voidedAt        DateTime?     @map("voided_at")
  voidedById      String?       @map("voided_by_id")
  voidedBy        User?         @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason      String?       @map("void_reason")
  receivedById    String?       @map("received_by_id")
  receivedBy      User?         @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  refunds         Refund[]

  @@index([invoiceId])
  @@index([patientId])
  @@index([paymentDate])
  @@index([paidAt])
  @@map("payments")
}

// ── Refunds ───────────────────────────────────────────────────
model Refund {
  id              String       @id @default(uuid())
  refundNumber    String       @unique @map("refund_number") // e.g. "REF-2026-0001"
  paymentId       String       @map("payment_id")
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String       @map("invoice_id")
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  status          RefundStatus @default(REQUESTED)
  requestedById   String?      @map("requested_by_id")
  requestedBy     User?        @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById    String?      @map("approved_by_id")
  approvedBy      User?        @relation("RefundApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?    @map("approved_at")
  processedById   String?      @map("processed_by_id")
  processedBy     User?        @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt     DateTime?    @map("processed_at")
  refundMethod    String?      @map("refund_method") // CASH, CARD, UPI, BANK_TRANSFER, OTHER
  referenceNumber String?      @map("reference_number")
  rejectionReason String?      @map("rejection_reason")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([invoiceId])
  @@index([status])
  @@map("refunds")
}

// ── Expenses ──────────────────────────────────────────────────
model Expense {
  id              String        @id @default(uuid())
  expenseNumber   String        @unique @map("expense_number") // e.g. "EXP-2026-0001"
  expenseDate     DateTime      @default(now()) @map("expense_date") @db.Date
  category        String        // Medical Supplies, Facility & Utilities, Equipment Maintenance, Administrative, Staff & Training, Other
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   String        @default("BANK_TRANSFER") @map("payment_method") // CASH, CARD, UPI, BANK_TRANSFER, CHEQUE
  vendor          String?       // Vendor name
  referenceNumber String?       @map("reference_number")
  status          ExpenseStatus @default(RECORDED)
  notes           String?
  createdById     String?       @map("created_by_id")
  createdBy       User?         @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?     @map("cancelled_at")
  cancelledById   String?       @map("cancelled_by_id")
  cancelledBy     User?         @relation("ExpenseCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason    String?       @map("cancel_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([expenseDate])
  @@index([category, status])
  @@map("expenses")
}

// ── Emergency Registrations (Front Desk Fast Path) ────────────
enum EmergencyPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum EmergencyStatus {
  TRIAGED
  ADMITTED
  IN_TREATMENT
  DISCHARGED
  TRANSFERRED
}

model EmergencyRegistration {
  id               String            @id @default(uuid())
  emergencyNumber  String            @unique @map("emergency_number") // e.g. "EMG-2026-001"
  patientId        String            @map("patient_id")
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  arrivedAt        DateTime          @default(now()) @map("arrived_at")
  priority         EmergencyPriority @default(HIGH)
  reason           String
  status           EmergencyStatus   @default(TRIAGED)
  triageNotes      String?           @map("triage_notes")
  assignedDoctorId String?           @map("assigned_doctor_id")
  assignedBedId    String?           @map("assigned_bed_id")
  registeredById   String?           @map("registered_by_id")
  registeredBy     User?             @relation("EmergencyRegistrar", fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([priority, status])
  @@index([arrivedAt])
  @@map("emergency_registrations")
}

// ── Laboratory Diagnostics Ecosystem ──────────────────────────
enum LabSampleType {
  BLOOD
  SERUM
  PLASMA
  URINE
  STOOL
  SPUTUM
  SWAB
  CSF
  TISSUE
  OTHER
}

enum LabSampleStatus {
  PENDING
  COLLECTED
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_PENDING
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_PENDING
  COMPLETED
  CANCELLED
}

enum LabOrderItemStatus {
  ORDERED
  SAMPLE_PENDING
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_PENDING
  COMPLETED
  CANCELLED
}

enum LabOrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum LabResultStatus {
  PENDING
  ENTERED
  VERIFIED
  RELEASED
  REJECTED
}

enum LabResultType {
  NUMERIC
  TEXT
  POSITIVE_NEGATIVE
  QUALITATIVE
}

enum LabResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
  NOT_EVALUATED
}

enum LabReportStatus {
  DRAFT
  COMPLETED
  VERIFIED
  RELEASED
}

model LabTechnicianProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String   @unique @map("employee_id")
  department       String   @default("Clinical Pathology & Biochemistry")
  licenseNumber    String?  @map("license_number")
  shift            String   @default("Morning (08:00 - 16:00)")
  isSeniorVerifier Boolean  @default(false) @map("is_senior_verifier")
  status           String   @default("On Duty") // On Duty, Off Duty, On Break
  phone            String?
  bio              String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("lab_technician_profiles")
}

model LabTest {
  id             String             @id @default(uuid())
  code           String             @unique // e.g. "LAB-CBC", "LAB-LFT"
  name           String
  category       String             // Hematology, Biochemistry, Microbiology, Serology, Urinalysis
  description    String?
  sampleType     LabSampleType      @default(BLOOD) @map("sample_type")
  sampleVolume   String?            @map("sample_volume") // e.g. "3 mL"
  processingTime Int                @default(60) @map("processing_time") // Minutes
  price          Decimal            @db.Decimal(10, 2)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  parameters     LabTestParameter[]
  orderItems     LabTestOrderItem[]

  @@index([name])
  @@index([category, isActive])
  @@map("lab_tests")
}

model LabTestParameter {
  id              String         @id @default(uuid())
  labTestId       String         @map("lab_test_id")
  labTest         LabTest        @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  name            String         // e.g. "Hemoglobin", "WBC Count", "Platelets"
  resultType      LabResultType  @default(NUMERIC) @map("result_type")
  unit            String?        // e.g. "g/dL", "10^3/uL", "mg/dL"
  displayOrder    Int            @default(1) @map("display_order")
  low             Decimal?       @db.Decimal(10, 2)
  high            Decimal?       @db.Decimal(10, 2)
  criticalLow     Decimal?       @map("critical_low") @db.Decimal(10, 2)
  criticalHigh    Decimal?       @map("critical_high") @db.Decimal(10, 2)
  allowedOptions  String[]       @default([]) @map("allowed_options") // For QUALITATIVE / POSITIVE_NEGATIVE
  genderSpecific  String?        @map("gender_specific") // "MALE", "FEMALE", or null
  ageMin          Int?           @map("age_min")
  ageMax          Int?           @map("age_max")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  resultValues    LabResultValue[]

  @@index([labTestId, displayOrder])
  @@map("lab_test_parameters")
}

model LabTestOrder {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique @map("order_number") // e.g. "ORD-2026-0001"
  patientId          String           @map("patient_id")
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderingDoctorId   String           @map("ordering_doctor_id")
  orderingDoctor     DoctorProfile    @relation(fields: [orderingDoctorId], references: [id], onDelete: Cascade)
  consultationId     String?          @map("consultation_id")
  appointmentId      String?          @map("appointment_id")
  status             LabOrderStatus   @default(ORDERED)
  priority           LabOrderPriority @default(ROUTINE)
  clinicalIndication String?          @map("clinical_indication")
  orderedAt          DateTime         @default(now()) @map("ordered_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  items              LabTestOrderItem[]
  samples            LabSample[]
  reports            LabReport[]

  @@index([patientId, orderedAt])
  @@index([orderingDoctorId, status])
  @@index([status, priority])
  @@map("lab_test_orders")
}

model LabTestOrderItem {
  id               String             @id @default(uuid())
  orderId          String             @map("order_id")
  order            LabTestOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTestId        String             @map("lab_test_id")
  labTest          LabTest            @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  testNameSnapshot String             @map("test_name_snapshot")
  priceSnapshot    Decimal            @map("price_snapshot") @db.Decimal(10, 2)
  status           LabOrderItemStatus @default(ORDERED)
  sampleId         String?            @map("sample_id")
  sample           LabSample?         @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  cancelReason     String?            @map("cancel_reason")
  cancelledAt      DateTime?          @map("cancelled_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  results          LabResult[]
  invoiceItems     InvoiceItem[]

  @@index([orderId])
  @@index([labTestId])
  @@map("lab_test_order_items")
}

model LabSample {
  id                    String          @id @default(uuid())
  sampleCode            String          @unique @map("sample_code") // e.g. "LAB-SMP-000001"
  orderId               String          @map("order_id")
  order                 LabTestOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId             String          @map("patient_id")
  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sampleType            LabSampleType   @map("sample_type")
  status                LabSampleStatus @default(PENDING)
  collectedAt           DateTime?       @map("collected_at")
  collectedById         String?         @map("collected_by_id")
  collectedBy           User?           @relation("SampleCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  sampleCondition       String?         @map("sample_condition") // Good, Hemolyzed, Lipemic, Clotted
  collectionNotes       String?         @map("collection_notes")
  receivedAt            DateTime?       @map("received_at")
  receivedById          String?         @map("received_by_id")
  receivedBy            User?           @relation("SampleReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  processingStartedAt   DateTime?       @map("processing_started_at")
  processingStartedById String?         @map("processing_started_by_id")
  processingStartedBy   User?           @relation("SampleProcessor", fields: [processingStartedById], references: [id], onDelete: SetNull)
  processingCompletedAt DateTime?       @map("processing_completed_at")
  processingCompletedById String?       @map("processing_completed_by_id")
  processingCompletedBy User?           @relation("SampleCompleter", fields: [processingCompletedById], references: [id], onDelete: SetNull)
  rejectionReason       String?         @map("rejection_reason")
  rejectedAt            DateTime?       @map("rejected_at")
  rejectedById          String?         @map("rejected_by_id")
  rejectedBy            User?           @relation("SampleRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  recollectionOfId      String?         @map("recollection_of_id")
  recollectionOf        LabSample?      @relation("Recollections", fields: [recollectionOfId], references: [id], onDelete: SetNull)
  recollections         LabSample[]     @relation("Recollections")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  orderItems            LabTestOrderItem[]
  results               LabResult[]

  @@index([orderId])
  @@index([patientId])
  @@index([status])
  @@map("lab_samples")
}

model LabResult {
  id              String          @id @default(uuid())
  orderItemId     String          @map("order_item_id")
  orderItem       LabTestOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sampleId        String          @map("sample_id")
  sample          LabSample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  status          LabResultStatus @default(PENDING)
  version         Int             @default(1)
  enteredById     String?         @map("entered_by_id")
  enteredBy       User?           @relation("ResultEnterer", fields: [enteredById], references: [id], onDelete: SetNull)
  enteredAt       DateTime?       @map("entered_at")
  verifiedById    String?         @map("verified_by_id")
  verifiedBy      User?           @relation("ResultVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?       @map("verified_at")
  rejectionReason String?         @map("rejection_reason")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  values          LabResultValue[]
  corrections     LabResultCorrection[]

  @@unique([orderItemId, version])
  @@index([orderItemId, status])
  @@index([sampleId])
  @@map("lab_results")
}

model LabResultValue {
  id                     String           @id @default(uuid())
  labResultId            String           @map("lab_result_id")
  labResult              LabResult        @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  parameterId            String           @map("parameter_id")
  parameter              LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  numericValue           Decimal?         @map("numeric_value") @db.Decimal(10, 2)
  textValue              String?          @map("text_value")
  unitSnapshot           String?          @map("unit_snapshot")
  referenceRangeSnapshot String?          @map("reference_range_snapshot")
  flag                   LabResultFlag    @default(NOT_EVALUATED)
  createdAt              DateTime         @default(now()) @map("created_at")

  @@index([labResultId])
  @@index([parameterId])
  @@map("lab_result_values")
}

model LabResultCorrection {
  id              String    @id @default(uuid())
  labResultId     String    @map("lab_result_id")
  labResult       LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  originalValues  Json      @map("original_values")
  correctedValues Json      @map("corrected_values")
  reason          String
  correctedById   String?   @map("corrected_by_id")
  correctedBy     User?     @relation("ResultCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt     DateTime  @default(now()) @map("corrected_at")

  @@index([labResultId])
  @@map("lab_result_corrections")
}

model LabReport {
  id              String          @id @default(uuid())
  orderId         String          @map("order_id")
  order           LabTestOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportNumber    String          @unique @map("report_number") // e.g. "REP-2026-0001"
  status          LabReportStatus @default(DRAFT)
  revision        Int             @default(1)
  generatedAt     DateTime?       @map("generated_at")
  verifiedAt      DateTime?       @map("verified_at")
  releasedAt      DateTime?       @map("released_at")
  createdById     String?         @map("created_by_id")
  createdBy       User?           @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedById    String?         @map("verified_by_id")
  verifiedBy      User?           @relation("ReportVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  releasedById    String?         @map("released_by_id")
  releasedBy      User?           @relation("ReportReleaser", fields: [releasedById], references: [id], onDelete: SetNull)
  contentSnapshot Json?           @map("content_snapshot") // Immutable snapshot payload upon release
  isAmended       Boolean         @default(false) @map("is_amended")
  amendedAt       DateTime?       @map("amended_at")
  doctorNotes     String?         @map("doctor_notes") // Doctor review interpretation
  isReviewed      Boolean         @default(false) @map("is_reviewed")
  reviewedAt      DateTime?       @map("reviewed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  documents       Document[]

  @@unique([orderId, revision])
  @@index([orderId, status])
  @@index([reportNumber])
  @@map("lab_reports")
}

model Document {
  id              String         @id @default(uuid())
  patientId       String         @map("patient_id")
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title           String
  category        String         // "Lab Report", "Prescription", "Medical Document", "Consultation Note", "Insurance Document", "Other"
  source          String         @default("STAFF") // STAFF, PATIENT
  uploadedByUserId String?       @map("uploaded_by_user_id")
  patientVisible  Boolean        @default(true) @map("patient_visible")
  fileUrl         String         @map("file_url")
  fileSize        String?        @map("file_size")
  mimeType        String?        @map("mime_type")
  storageKey      String?        @map("storage_key")
  sizeBytes       BigInt?        @map("size_bytes")
  checksum        String?
  deletedAt       DateTime?      @map("deleted_at")
  medicalRecordId String?        @map("medical_record_id")
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  prescriptionId  String?        @map("prescription_id")
  prescription    Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  labReportId     String?        @map("lab_report_id")
  labReport       LabReport?     @relation(fields: [labReportId], references: [id], onDelete: SetNull)
  uploadedAt      DateTime       @default(now()) @map("uploaded_at")

  @@index([patientId, category])
  @@index([patientId, patientVisible])
  @@map("documents")
}

// ── Patient Portal: Portal Invites ────────────────────────────
model PortalInvite {
  id            String    @id @default(uuid())
  patientId     String    @map("patient_id")
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  inviteCode    String    @unique @map("invite_code")
  email         String
  expiresAt     DateTime  @map("expires_at")
  isRedeemed    Boolean   @default(false) @map("is_redeemed")
  redeemedAt    DateTime? @map("redeemed_at")
  attemptsCount Int       @default(0) @map("attempts_count")
  createdById   String?   @map("created_by_id")
  createdBy     User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([patientId])
  @@index([inviteCode])
  @@index([expiresAt])
  @@map("portal_invites")
}

// ── Patient Portal: Online Payment Attempts ───────────────────
model PaymentAttempt {
  id                String   @id @default(uuid())
  patientId         String   @map("patient_id")
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoiceId         String   @map("invoice_id")
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("INITIATED") // INITIATED, SUCCEEDED, FAILED, EXPIRED
  providerReference String?  @map("provider_reference")
  idempotencyKey    String   @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([invoiceId])
  @@map("payment_attempts")
}

// ── Patient Portal: Insurance Policies & Claims (Read-Only) ───
model InsurancePolicy {
  id            String           @id @default(uuid())
  patientId     String           @map("patient_id")
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider      String
  policyNumber  String           @map("policy_number")
  coverageType  String           @default("Comprehensive Health") @map("coverage_type")
  coverageLimit Decimal          @default(500000.00) @map("coverage_limit") @db.Decimal(12, 2)
  validFrom     DateTime         @map("valid_from") @db.Date
  validThru     DateTime         @map("valid_thru") @db.Date
  status        String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  claims        InsuranceClaim[]

  @@index([patientId])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id              String          @id @default(uuid())
  policyId        String          @map("policy_id")
  policy          InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  patientId       String          @map("patient_id")
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  claimNumber     String          @unique @map("claim_number")
  claimDate       DateTime        @default(now()) @map("claim_date") @db.Date
  amount          Decimal         @db.Decimal(12, 2)
  approvedAmount  Decimal?        @map("approved_amount") @db.Decimal(12, 2)
  status          String          @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED
  description     String?
  adjudicatedAt   DateTime?       @map("adjudicated_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([policyId])
  @@map("insurance_claims")
}

// ── Follow-ups & Notifications ────────────────────────────────
model FollowUp {
  id          String        @id @default(uuid())
  doctorId    String        @map("doctor_id")
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId   String        @map("patient_id")
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  followUpDate DateTime     @map("follow_up_date") @db.Date
  reason      String
  notes       String?
  status      String        @default("Pending") // Pending, Completed, Cancelled
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([doctorId, followUpDate])
  @@map("follow_ups")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   @default("INFO") // INFO, URGENT, APPOINTMENT, LAB_RESULT
  isRead     Boolean  @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  entityType String?  @map("entity_type") // Appointment, LabReport, Consultation, Invoice, Payment
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?  @map("user_name")
  role        String?
  action      String
  entity      String?
  entityId    String?  @map("entity_id")
  description String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ── Pharmacy: Medicine Catalog ────────────────────────────────
model Medicine {
  id           String   @id @default(uuid())
  medicineCode String   @unique @map("medicine_code") // e.g. "MED-2026-001"
  name         String
  genericName  String   @map("generic_name")
  brandName    String?  @map("brand_name")
  category     String   // Antibiotic, Analgesic, Antipyretic, Cardiovascular, Antidiabetic, etc.
  manufacturer String
  strength     String   // e.g. "500mg", "10mg/ml"
  dosageForm   String   @map("dosage_form") // Tablet, Capsule, Syrup, Injection, Inhaler, Ointment
  route        String   @default("Oral") // Oral, IV, IM, Topical, Inhalation
  unit         String   @default("Tablets") // Tablets, Capsules, Vials, Bottles, Strips
  sellingPrice Decimal  @map("selling_price") @db.Decimal(10, 2)
  reorderLevel Int      @default(20) @map("reorder_level")
  status       String   @default("Active") // Active, Inactive
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  batches           MedicineBatch[]
  stockTransactions StockTransaction[]
  prescriptionItems PrescriptionItem[]
  dispensingItems   DispensingItem[]
  receiptItems      StockReceiptItem[]

  @@index([name])
  @@index([genericName])
  @@index([category, status])
  @@map("medicines")
}

// ── Pharmacy: Medicine Batches ────────────────────────────────
model MedicineBatch {
  id                String    @id @default(uuid())
  medicineId        String    @map("medicine_id")
  medicine          Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber       String    @map("batch_number") // e.g. "BAT-2026-001"
  manufacturer      String?
  supplier          String?
  receivedDate      DateTime  @default(now()) @map("received_date")
  expiryDate        DateTime  @map("expiry_date") @db.Date // Date-only column
  quantityReceived  Int       @map("quantity_received")
  quantityAvailable Int       @map("quantity_available") // Cached sum of ledger
  purchaseCost      Decimal?  @map("purchase_cost") @db.Decimal(10, 2)
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(10, 2)
  status            String    @default("Active") // Active, Quarantined, WrittenOff, Expired
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  transactions    StockTransaction[]
  dispensingItems DispensingItem[]

  @@unique([medicineId, batchNumber])
  @@index([expiryDate])
  @@index([medicineId, quantityAvailable])
  @@map("medicine_batches")
}

// ── Pharmacy: Append-Only Stock Transaction Ledger ────────────
model StockTransaction {
  id                String        @id @default(uuid())
  transactionNumber String        @unique @map("transaction_number") // e.g. "TXN-2026-0001"
  medicineId        String        @map("medicine_id")
  medicine          Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId           String        @map("batch_id")
  batch             MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantityChange    Int           @map("quantity_change") // Signed integer (+50, -10)
  type              String        // RECEIPT, DISPENSE, ADJUSTMENT_INCREASE, ADJUSTMENT_DECREASE, EXPIRY_WRITE_OFF, RETURN
  reason            String?
  balanceAfter      Int           @map("balance_after")
  performedById     String?       @map("performed_by_id")
  performedBy       User?         @relation("StockTransactionPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  dispensingId      String?       @map("dispensing_id")
  dispensing        Dispensing?   @relation(fields: [dispensingId], references: [id], onDelete: SetNull)
  receiptId         String?       @map("receipt_id")
  receipt           StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([batchId, createdAt])
  @@index([medicineId, createdAt])
  @@index([type])
  @@map("stock_transactions")
}

// ── Pharmacy: Stock Receipts ──────────────────────────────────
model StockReceipt {
  id               String             @id @default(uuid())
  receiptNumber    String             @unique @map("receipt_number") // e.g. "REC-2026-0001"
  supplier         String
  invoiceReference String?            @map("invoice_reference")
  receivedDate     DateTime           @default(now()) @map("received_date")
  receivedById     String?            @map("received_by_id")
  receivedBy       User?              @relation("StockReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")

  items            StockReceiptItem[]
  transactions     StockTransaction[]

  @@map("stock_receipts")
}

model StockReceiptItem {
  id               String       @id @default(uuid())
  receiptId        String       @map("receipt_id")
  receipt          StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  medicineId       String       @map("medicine_id")
  medicine         Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber      String       @map("batch_number")
  quantityReceived Int          @map("quantity_received")
  purchaseCost     Decimal?     @map("purchase_cost") @db.Decimal(10, 2)
  expiryDate       DateTime     @map("expiry_date") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("stock_receipt_items")
}

// ── Pharmacy: Dispensing & Dispensing Items ───────────────────
model Dispensing {
  id               String           @id @default(uuid())
  dispensingNumber String           @unique @map("dispensing_number") // e.g. "DSP-2026-0001"
  prescriptionId   String           @map("prescription_id")
  prescription     Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patientId        String           @map("patient_id")
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacistId     String?          @map("pharmacist_id")
  pharmacist       User?            @relation("DispensingPharmacist", fields: [pharmacistId], references: [id], onDelete: SetNull)
  status           String           @default("Completed") // Completed, Cancelled
  idempotencyKey   String           @unique @map("idempotency_key")
  totalAmount      Decimal          @map("total_amount") @db.Decimal(10, 2)
  notes            String?
  invoiceId        String?          @map("invoice_id")
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at")

  items            DispensingItem[]
  transactions     StockTransaction[]

  @@index([prescriptionId])
  @@index([patientId])
  @@index([pharmacistId])
  @@index([createdAt])
  @@map("dispensings")
}

model DispensingItem {
  id                   String            @id @default(uuid())
  dispensingId         String            @map("dispensing_id")
  dispensing           Dispensing        @relation(fields: [dispensingId], references: [id], onDelete: Cascade)
  prescriptionItemId   String?           @map("prescription_item_id")
  prescriptionItem     PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  medicineId           String            @map("medicine_id")
  medicine             Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId              String            @map("batch_id")
  batch                MedicineBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  medicineNameSnapshot String            @map("medicine_name_snapshot")
  batchNumberSnapshot  String            @map("batch_number_snapshot")
  quantity             Int
  unitPriceSnapshot    Decimal           @map("unit_price_snapshot") @db.Decimal(10, 2)
  totalPrice           Decimal           @map("total_price") @db.Decimal(10, 2)
  instructionsSnapshot String?           @map("instructions_snapshot")
  createdAt            DateTime          @default(now()) @map("created_at")

  @@map("dispensing_items")
}
